{
  "name": "skyfare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkyFare - a smart flight ticket booking tracker demo. Fly smart. Pay less.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/generate-data.ts",
    "train": "python3 ml/train_model.py",
    "ml": "npm run data && npm run train",
    "test": "node --test tests/unit/",
    "check:i18n": "node scripts/check-i18n.ts",
    "e2e": "node tests/e2e/smoke.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
